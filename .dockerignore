# Send only files used by Dockerfile. This avoids walking local virtual
# environments, Git objects, databases, logs, test data, and model caches.
**

!pyproject.toml
!requirements.txt
!requirements-dev.txt
!entrypoint.sh

!src/
!src/**
!tests/
!tests/**
!web/
!web/**

# Generated Python files can exist below included source directories.
**/__pycache__/
**/*.py[cod]

# Download the large Piper model in a cached Docker layer instead of sending
# it through Docker Desktop's slow macOS build-context file sharing.
**/*.onnx

# Local state must never be baked into the image.
**/.local/
**/*.sqlite3
**/*.db
