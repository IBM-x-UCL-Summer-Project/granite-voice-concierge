# Granite Voice Concierge - Docker Environment Configuration

# Ollama runs natively on macOS or Windows. Containers reach it through Docker
# Desktop's host gateway. On Linux, replace this with a reachable host address
# if needed.
OLLAMA_API_URL=http://host.docker.internal:11434

# Logging
PYTHONUNBUFFERED=1
GVC_LOG_LEVEL=INFO

# Model Selection
# Override this value with any Ollama model name. The quick-start script pulls
# the selected model automatically before starting the application.
OLLAMA_MODEL=granite4.1:8b

# Speech recognition uses any faster-whisper model name, compatible Hugging
# Face model ID, or converted local model directory. Larger models download to
# the persistent model cache on first use. CPU + int8 is the portable default;
# CUDA users may select a device/compute combination supported by CTranslate2.
GVC_STT_MODEL=base.en
GVC_STT_DEVICE=cpu
GVC_STT_COMPUTE_TYPE=int8

# Piper voice identifier. Docker downloads this voice while building the image.
# Run `python -m voice_concierge.voice_output.download_models --list` in a local
# environment to see the upstream catalogue, and review each voice's model card
# before distribution.
GVC_TTS_VOICE=en_GB-alan-medium

# Container User
# Native Linux users can match the container process to the owner of the
# bind-mounted data directory. Docker Desktop does not normally require this.
# APP_UID=1000
# APP_GID=1000
