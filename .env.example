# Granite Voice Concierge - Docker Environment Configuration

# Ollama Configuration
OLLAMA_API_URL=http://ollama:11434
# For external Ollama:
# OLLAMA_API_URL=http://host.docker.internal:11434  # macOS/Windows
# OLLAMA_API_URL=http://192.168.1.100:11434        # Linux (use your machine IP)

# Logging
PYTHONUNBUFFERED=1
LOG_LEVEL=DEBUG
# Suppress specific verbose modules
# PYTHONDONTWRITEBYTECODE=1

# Voice Configuration
# VOICE_IO=true          # Enable voice input/output
# AUDIO_DEVICE_INDEX=0   # Specific audio device (use arecord -l to find)

# Model Selection
# Override this value with any Ollama model name. The quick-start script pulls
# the selected model automatically before starting the application.
OLLAMA_MODEL=granite4.1:8b

# Memory & Performance
# MEMORY_LIMIT=2gb       # Docker memory limit (if set in compose)
# FASTER_WHISPER_DEVICE=cpu  # Or 'cuda' if GPU available

# Development
# DEBUG=1
# PYTEST_ADDOPTS=--verbose

# Data & Privacy
# DATA_DIR=/app/.local   # Where to store persistent data
# RETENTION_DAYS=365     # Auto-delete memories older than N days
